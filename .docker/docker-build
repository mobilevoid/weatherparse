##
# File: .docker/docker-build
# Setup WeatherParse Docker Container
##

function _setFlags() {
  echo "DOCKER=1" >>/etc/os-release
  echo "DOCKER=1" >>/etc/environment
}

function _permissions() {
  echo "Modifying start-up script PERMISSIONS"
  chmod +x /usr/local/bin/docker-entrypoint
  chmod +x /usr/local/bin/docker-healthcheck
  echo "END: PERMISSIONS"
}

function _logging() {
  echo "Setup LOGGING"
  sed -i '/imklog/s/^/#/' /etc/rsyslog.conf
  ln -sf /proc/1/fd/1 /var/log/syslog
  rm /var/log/apache2/error.log && touch /var/log/apache2/error.log
  rm /var/log/apache2/access.log && touch /var/log/apache2/access.log
  touch /opt/weatherparse/logs/cron.log
  echo "END: LOGGING"
}

function _http() {
  echo "Setting up HTTPD"
  openssl req -x509 -nodes -days 365 -newkey rsa:4096 \
    -keyout /etc/ssl/private/ssl-cert-snakeoil.key \
    -out /etc/ssl/certs/ssl-cert-snakeoil.pem \
    -subj "/C=US/ST=Denver/L=Denver/O=Security/OU=Production/CN=weatherparse" \
    -addext "subjectAltName=DNS:weatherparse,DNS:localhost,IP:127.0.0.1"
  chown -R www-data:www-data /var/log/apache2
  chown -R www-data:www-data "${WEATHERPARSE_DIR}"/src/pub
  a2dissite 000-default.conf
  rm /etc/apache2/sites-available/000-default.conf /etc/apache2/sites-available/default-ssl.conf
  cp "${WEATHERPARSE_DIR}"/config/weatherparse.conf /etc/apache2/sites-available/
  cp "${WEATHERPARSE_DIR}"/config/weatherparse-ssl.conf /etc/apache2/sites-available/
  rm -rf "${WEATHERPARSE_DIR}"/config
  mkdir -p /var/opt/weatherparse/config && cp "${WEATHERPARSE_DIR}"/src/usr/config.new.php /var/opt/weatherparse/config/config.new.php
  a2ensite weatherparse.conf
  a2ensite weatherparse-ssl.conf
  a2enmod rewrite ssl
  mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
  echo "END: HTTPD"
}

function _openSSL() {
  echo "Configuring OpenSSL for TLS v1.1 support"
  sed -i 's/MinProtocol = TLSv1.2/MinProtocol = TLSv1.1/' /etc/ssl/openssl.cnf
  sed -i 's/SECLEVEL=2/SECLEVEL=1/' /etc/ssl/openssl.cnf
  echo "END: OpenSSL Config"
}

echo "START: WeatherParse Docker BUILD ..."
_setFlags
_permissions
_logging
_http
_openSSL
echo "END: WeatherParse BUILD"
