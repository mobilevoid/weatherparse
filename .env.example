# WeatherParse Docker settings. Copy to .env (never commit .env) and change the passwords.
TZ=America/Chicago
MYSQL_DATABASE=weatherparse
MYSQL_USER=weatherparse
MYSQL_PASSWORD=change-me-weatherparse
MYSQL_ROOT_PASSWORD=change-me-root
# Ports on the host. The AcuRite Access sends to 443, so keep HTTPS_PORT=443 if the hub posts to this host.
HTTP_PORT=80
HTTPS_PORT=443
# Use a prebuilt image instead of building locally (optional)
# WEATHERPARSE_IMAGE=ghcr.io/mobilevoid/weatherparse:latest
