# File: cam/templates/combined
# IP camera shell script
##

function _getImage() {
  if [ "$USE_RTSP" == 0 ]; then
    # HTTP Snapshot
    curl "${CAMERA_HOST}" --output "${CAMERA_FILENAME}"
  else
    # RTSP Snapshot
    ffmpeg -rtsp_transport tcp -loglevel fatal -i "$CAMERA_HOST" -vframes 1 -r 1 "$CAMERA_FILENAME"
  fi
}

function _timestamp() {
  echo "Applying Timestamp and Copyright"
  convert "${CAMERA_FILENAME}" \
    -resize "${RESIZE}"! \
    -font DejaVu-Sans-Bold -pointsize 20 \
    -draw "gravity south \
        fill black  text 0,36 '$TIMESTAMP' \
        fill OrangeRed2  text 1,37 '$TIMESTAMP' " \
    -font DejaVu-Sans-Bold -pointsize 12 \
    -draw "gravity south \
        fill black  text 0,0 '$WATERMARK' \
        fill OrangeRed2  text 1,1 '$WATERMARK' " \
    image.jpg
}

function _localArchive() {
  ARCHIVE=$(date +"%F_%H%M")
  mkdir -p "${ARCHIVE_DIR}"/"$(date +%Y)"
  FOLDER="$(date +%Y)"
  convert "$CAMERA_FILENAME" \
    -font DejaVu-Sans-Bold -pointsize 16 \
    -draw "gravity south \
     fill black  text 0,36 '$TIMESTAMP' \
      fill OrangeRed2  text 1,37 '$TIMESTAMP' " \
    archive.jpg
  mv archive.jpg "${ARCHIVE_DIR}"/"${FOLDER}"/"${ARCHIVE}".jpg
}

function _remoteServer() {
  scp image.jpg "${REMOTE_USER}"@"${REMOTE_HOST}":"${REMOTE_TMP}"
}

function _runRemote() {
  # shellcheck disable=SC2029
  ssh "${REMOTE_USER}"@"${REMOTE_HOST}" 'bash ' "${REMOTE_SCRIPT}"
}

function _watermark() {
  convert image.jpg \
    -font DejaVu-Sans-Bold -pointsize 12 \
    -draw "gravity south \
        fill black  text 0,18 '$STATION_INFO' \
        fill OrangeRed2  text 1,19 '$STATION_INFO' " \
    image.jpg
}

function _moveImage() {
  mkdir -p "${WEBDIR}"
  cp image.jpg "${WEBDIR}"/latest.jpg
  mkdir -p "${WEBDIR}"/"${ARCHIVE_DATE}"
  cp image.jpg "${WEBDIR}"/"${ARCHIVE_DATE}"/"${ARCHIVE_TIME}".jpg
  chown -R "${APACHE_USER}":"${APACHE_GROUP}" "${WEBDIR}"
  convert -delay 25 -loop 0 "${WEBDIR}"/"${ARCHIVE_DATE}"/*.jpg "${WEBDIR}"/"${ARCHIVE_DATE}"/daily.gif
}
# Delete camera images older than KEEP_DAYS (0 or unset = keep everything).
# Goes by the date in the name: web folders YYYY-MM-DD and archive files YYYY-MM-DD_HHMM.jpg.
function _cleanup() {
  if [ -z "${KEEP_DAYS}" ] || [ "${KEEP_DAYS}" -le 0 ] 2>/dev/null; then
    return
  fi
  CUTOFF=$(date -d "-${KEEP_DAYS} days" +"%Y-%m-%d")
  echo "Removing images older than ${KEEP_DAYS} days (before ${CUTOFF})"
  if [ -d "${WEBDIR}" ]; then
    for DIR in "${WEBDIR}"/????-??-??; do
      [ -d "${DIR}" ] || continue
      NAME=$(basename "${DIR}")
      [[ "${NAME}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
      [[ "${NAME}" < "${CUTOFF}" ]] && rm -rf -- "${DIR}"
    done
  fi
  if [ -d "${ARCHIVE_DIR}" ]; then
    find "${ARCHIVE_DIR}" -type f -regextype posix-extended -regex ".*/[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}\.jpg" -print0 |
      while IFS= read -r -d "" FILE; do
        DAY=$(basename "${FILE}" | cut -c1-10)
        [[ "${DAY}" < "${CUTOFF}" ]] && rm -f -- "${FILE}"
      done
    find "${ARCHIVE_DIR}" -mindepth 1 -type d -empty -delete
  fi
}

# Only one run at a time (a slow camera or cleanup must not overlap the next cron run).
exec 9>/tmp/weatherparse-webcam.lock
flock -n 9 || { echo "Another webcam run is still busy; skipping"; exit 0; }

# shellcheck source=templates/config.env
source /opt/weatherparse/cam/config.env

# "webcam cleanup" only removes images older than KEEP_DAYS (run once a day from cron).
if [ "$1" == 'cleanup' ]; then
  _cleanup
  if [ -n "${CAMERA2_HOST}" ]; then
    WEBDIR="${WEBDIR2:-${WEBDIR%/}2}"
    ARCHIVE_DIR="${ARCHIVE_DIR2:-${ARCHIVE_DIR%/}2}"
    _cleanup
  fi
  exit 0
fi

if [ "$MODE" == '' ]; then
  echo "Config Missing"
  exit 1
fi

# Capture, stamp, archive and publish one camera (the variables say which).
function _runCamera() {
  if [ "$MODE" == 'combined' ] || [ "$MODE" == 'local' ]; then
    cd "${BASEDIR}" || exit 1

    echo "Getting camera image"
    _getImage

    echo "Processing image and adding Timestamp"
    _timestamp

    if [ "$MODE" == 'local' ]; then

      echo "Sending image to remote server for processing"
      _remoteServer

      echo "START: Running remote commands"
      _runRemote
    fi

    if [ "$LOCAL_ARCHIVE" == 1 ]; then
      echo "Archiving"
      _localArchive
    fi

  fi

  if [ "$MODE" == 'combined' ] || [ "$MODE" == 'remote' ]; then
    cd "${BASEDIR}" || exit 1

    echo "Applying Weather Info Watermark"
    _watermark

    echo "Moving image to webserver and updating animation"
    _moveImage

  fi

  if [ "$MODE" == 'combined' ] || [ "$MODE" == 'local' ]; then
    echo "Cleaning LOCAL TMP"
    rm image.jpg*
    rm "${CAMERA_FILENAME}"*
    echo "Done: LOCAL/COMBINED"
  elif [ "$MODE" == 'remote' ]; then
    echo "Cleaning REMOTE TMP"
    rm image.jpg*
    echo "END: Running remote commands"
  fi
}

# Camera 1
_runCamera

# Optional second camera (combined mode only): CAMERA2_HOST in config.env. Its images go to img/cam2 and archive2.
if [ -n "${CAMERA2_HOST}" ] && [ "$MODE" == 'combined' ]; then
  echo "Camera 2"
  CAMERA_HOST="${CAMERA2_HOST}"
  WATERMARK="${CAMERA2_WATERMARK:-$WATERMARK}"
  CAMERA_FILENAME="cam2-${CAMERA_FILENAME}"
  WEBDIR="${WEBDIR2:-${WEBDIR%/}2}"
  ARCHIVE_DIR="${ARCHIVE_DIR2:-${ARCHIVE_DIR%/}2}"
  _runCamera
fi
