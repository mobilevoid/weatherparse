# WeatherParse scheduled jobs
* * * * * root /usr/bin/php /opt/weatherparse/cron/cron.php > /opt/weatherparse/logs/cron.log 2>&1
*/10 * * * * root [ -f /opt/weatherparse/cam/config.env ] && /bin/bash /opt/weatherparse/cam/webcam > /opt/weatherparse/logs/cam.log 2>&1
15 3 * * * root [ -f /opt/weatherparse/cam/config.env ] && /bin/bash /opt/weatherparse/cam/webcam cleanup > /opt/weatherparse/logs/cam-cleanup.log 2>&1
# After the web installer has written the config, remove the installer's pre-filled database settings
* * * * * root [ -f /opt/weatherparse/src/usr/config.php ] && [ -e /etc/apache2/conf-enabled/weatherparse-installer.conf ] && a2disconf -q weatherparse-installer && rm -f /etc/apache2/conf-available/weatherparse-installer.conf && systemctl reload apache2
